{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.48",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "rap2hpoutre/fast-excel": "^5.15",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-typescript-transformer": "^3.3"
    },
    "require-dev": {
        "ace-of-aces/intellipest": "^1.0",
        "barryvdh/laravel-ide-helper": "^3.7",
        "brianium/paratest": "^7.24",
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.24",
        "fruitcake/laravel-debugbar": "^4.4",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "spatie/guidelines-skills": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel",
            "npm run check:fix"
        ],
        "lint:check": [
            "./vendor/bin/phpstan analyse --memory-limit=2G",
            "@rector:check",
            "pint --parallel --test",
            "npm run check",
            "npm run types:check"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@lint:check",
            "@test"
        ],
        "test": [
            "rm -rf public/storage/coverage",
            "@php artisan config:clear --ansi",
            "@php artisan test --parallel --coverage"
        ],
        "test:coverage-html": [
            "rm -rf public/storage/coverage",
            "@php artisan test --parallel --coverage-html public/storage/coverage",
            "@php artisan tinker --execute 'echo(url(\"/storage/coverage/index.html\"))'"
        ],
        "ide": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:models -W -R",
            "./vendor/bin/intellipest -o '_ide_helper_pest.php' -s --expectation-helpers",
            "./vendor/bin/pint --parallel"
        ],
        "rector:check": [
            "./vendor/bin/rector process --dry-run"
        ],
        "rector:fix": [
            "./vendor/bin/rector process",
            "./vendor/bin/pint --parallel"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "cp .hooks/pre-commit .git/hooks/pre-commit"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
